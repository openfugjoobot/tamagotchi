# Tamagotchi server — environment variables (names only, no values here).
#
# Copy to `.env` (gitignored) and fill in real values, or inject them as
# container environment / an env_file. Never commit real values.

# Postgres connection string (the `tamagotchi-postgres` container, or managed PG).
DATABASE_URL=

# Google OAuth client id — the audience the ID tokens are verified against.
GOOGLE_CLIENT_ID=

# Web Push (VAPID) credentials. Generate a key pair once with:
#   npx web-push generate-vapid-keys
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# HTTP port the server listens on (default 8080).
PORT=

# Directory holding `emu/rom0.bin`, `emu/rom2.bin`, `emu/tamalib.wasm`.
# Defaults to ./public relative to the compiled module; set it when the assets
# live elsewhere in the image.
PUBLIC_DIR=
