{
  "name": "tamagotchi",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfugjoobot/tamagotchi.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/gen-precache.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:build": "tsc -p tsconfig.server.json",
    "server:dev": "npm run server:build && node dist/server/src/main.js",
    "server:test": "vitest run tests/server-*.test.ts",
    "verify": "tsc --noEmit && vitest run && vite build && node scripts/gen-precache.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pg-mem": "^3.0.14",
    "typescript": "^5.6",
    "vite": "^6.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  }
}
